{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "AIOps backend가 마지막 LLM 요청에서 provider로부터 받은 실제 입력 토큰 수입니다. provider가 usage를 주지 않으면 0으로 보일 수 있습니다.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "max(aiops_llm_prompt_tokens_last{prompt_key=~\"$prompt_key\"})",
          "legendFormat": "최근 실제 입력 토큰",
          "refId": "A"
        }
      ],
      "title": "최근 실제 입력 토큰",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
