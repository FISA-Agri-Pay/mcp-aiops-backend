        "y": 11
      },
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum by (status, prompt_key) (increase(aiops_llm_requests_total{prompt_key=~\"$prompt_key\"}[1h]))",
          "legendFormat": "{{status}} / {{prompt_key}}",
          "refId": "A"
        }
      ],
      "title": "최근 1시간 LLM 요청 수",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "최근 1시간 동안의 LLM 실패 수입니다. context_length_exceeded가 나오면 입력 토큰 절감이 필요하다는 직접 신호입니다.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum by (error_type, prompt_key) (increase(aiops_llm_failures_total{prompt_key=~\"$prompt_key\"}[1h]))",
          "legendFormat": "{{error_type}} / {{prompt_key}}",
          "refId": "A"
        }
      ],
      "title": "최근 1시간 LLM 실패 수",
      "type": "timeseries"
    }
