    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "최근 1시간 동안의 LLM 요청 수입니다.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
