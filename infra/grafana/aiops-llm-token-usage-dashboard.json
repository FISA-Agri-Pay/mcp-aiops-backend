        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "max by (prompt_key, model) (aiops_llm_latency_ms_last{prompt_key=~\"$prompt_key\"})",
          "legendFormat": "{{prompt_key}} / {{model}}",
          "refId": "A"
        }
      ],
