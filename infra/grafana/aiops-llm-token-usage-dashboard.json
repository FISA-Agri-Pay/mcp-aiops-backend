    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "마지막 LLM 요청으로 직렬화된 prompt 문자열 크기입니다. 토큰 절감 전후 비교에 유용합니다.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "max by (prompt_key, model) (aiops_llm_prompt_chars_last{prompt_key=~\"$prompt_key\"})",
          "legendFormat": "{{prompt_key}} / {{model}}",
          "refId": "A"
        }
      ],
      "title": "최근 입력 크기(chars)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "LLM 응답 시간입니다. 토큰 절감 후 지연시간이 줄었는지 확인합니다.",
